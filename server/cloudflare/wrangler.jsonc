{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skybreak-jets",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "REGION": "enam",
    "ALLOWED_ORIGINS": "https://greenkeewi.github.io"
  },
  "durable_objects": { "bindings": [{"name":"SKY","class_name":"SkyRoom"}] },
  "migrations": [{"tag":"v1","new_sqlite_classes":["SkyRoom"]}],
  "observability": {"enabled":false}
}
